    <section class="report-section" aria-labelledby="metrics-heading">
      <h2 id="metrics-heading">Metrics</h2>
{% if base_report.important_metrics %}
      <ul class="metric-list" role="list">
{% for metric in base_report.important_metrics %}
        <li>{{ metric }}</li>
{% endfor %}
      </ul>
{% else %}
      <p class="empty-state">{{ empty_state }}</p>
{% endif %}
    </section>
