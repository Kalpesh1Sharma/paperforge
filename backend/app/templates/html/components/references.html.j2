    <section class="report-section" aria-labelledby="references-heading">
      <h2 id="references-heading">References</h2>
{% if render_context.references %}
      <ol class="reference-list">
{% for reference in render_context.references %}
        <li>
{% if reference.reference %}
          <span>{{ reference.reference }}</span>
{% endif %}
{% if reference.source_labels %}
          <p class="provenance"><span class="provenance-label">Sources</span> {{ reference.source_labels | join(", ") }}</p>
{% endif %}
        </li>
{% endfor %}
      </ol>
{% else %}
      <p class="empty-state">{{ empty_state }}</p>
{% endif %}
    </section>
