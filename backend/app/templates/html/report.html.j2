<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ base_report.title }}</title>
  <style id="paperforge-report-styles">
{{ css | safe }}
  </style>
  <style id="paperforge-print-styles" media="print">
{{ print_css | safe }}
  </style>
</head>
<body>
  <a class="skip-link" href="#report-content">Skip to report content</a>
  <main id="report-content" class="report" aria-labelledby="report-title">
    <header class="report-header">
      <p class="eyebrow">PaperForge Research Report</p>
      <h1 id="report-title">{{ base_report.title }}</h1>
    </header>

{% include "components/summary.html.j2" %}
{% include "components/findings.html.j2" %}

    <section class="report-section" aria-labelledby="important-entities-heading">
      <h2 id="important-entities-heading">Important Entities</h2>
{% if render_context.entity_groups %}
{% for group in render_context.entity_groups %}
{% if group.category %}
      <p class="category-chip">{{ group.category }}</p>
{% endif %}
      <ul class="tag-list" role="list">
{% for entity in group.entities %}
        <li>
          <span>{{ entity.name }}</span>
{% if entity.aliases %}
          <span class="entity-aliases">Also known as: {{ entity.aliases | join(", ") }}</span>
{% endif %}
{% if entity.confidence_label %}
          <span class="entity-confidence">Confidence {{ entity.confidence_label }}</span>
{% endif %}
{% if entity.source_count %}
          <span class="entity-evidence">{{ entity.source_count }} {{ "source" if entity.source_count == 1 else "sources" }}</span>
{% endif %}
{% if entity.source_labels %}
          <span class="entity-sources">{{ entity.source_labels | join(", ") }}</span>
{% endif %}
        </li>
{% endfor %}
      </ul>
{% endfor %}
{% else %}
      <p class="empty-state">{{ empty_state }}</p>
{% endif %}
    </section>

    <section class="report-section" aria-labelledby="definitions-heading">
      <h2 id="definitions-heading">Definitions</h2>
{% if render_context.definitions %}
      <ul class="definition-list" role="list">
{% for definition in render_context.definitions %}
        <li class="definition-item">
          <strong>{{ definition.concept }}</strong>
{% if definition.concept != definition.definition %}
          <span>{{ definition.definition }}</span>
{% endif %}
{% if definition.related_concepts %}
          <p class="related-concepts"><span class="provenance-label">Related concepts</span> {{ definition.related_concepts | join(", ") }}</p>
{% endif %}
{% if definition.confidence_label %}
          <dl class="intelligence-metadata" aria-label="Definition evidence details">
            <div><dt>Confidence</dt><dd>{{ definition.confidence_label }}</dd></div>
            <div><dt>Evidence</dt><dd>{{ definition.source_count }} {{ "source" if definition.source_count == 1 else "sources" }}</dd></div>
          </dl>
{% endif %}
{% if definition.source_labels %}
          <p class="provenance"><span class="provenance-label">Supported by</span> {{ definition.source_labels | join(", ") }}</p>
{% endif %}
{% if definition.references %}
          <p class="inline-references"><span class="provenance-label">References</span> {{ definition.references | join("; ") }}</p>
{% endif %}
        </li>
{% endfor %}
      </ul>
{% else %}
      <p class="empty-state">{{ empty_state }}</p>
{% endif %}
    </section>

{% include "components/metrics.html.j2" %}
{% include "components/timeline.html.j2" %}

{% for section in render_context.sections %}
    <section class="report-section synthesized-section" aria-labelledby="synthesized-section-{{ loop.index }}-heading">
      <h2 id="synthesized-section-{{ loop.index }}-heading">{{ section.heading }}</h2>
      <div class="prose">
        <p>{{ section.content }}</p>
      </div>
      <p class="provenance">
        <span class="provenance-label">Supported by</span>
{% for label in section.source_labels %}
        <span class="source-label">{{ label }}</span>{% if not loop.last %}, {% endif %}
{% endfor %}
      </p>
    </section>
{% endfor %}

{% include "components/references.html.j2" %}
{% include "components/appendix.html.j2" %}

    <section class="report-section generated-by" aria-labelledby="generated-by-heading">
      <h2 id="generated-by-heading">Generated By</h2>
      <dl class="generation-metadata">
        <div>
          <dt>Provider</dt>
          <dd>{{ report.synthesis_metadata.provider }}</dd>
        </div>
        <div>
          <dt>Model</dt>
          <dd>{{ report.synthesis_metadata.model or "Not applicable" }}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{% if report.synthesis_metadata.successful %}Successful{% else %}Unsuccessful{% endif %}</dd>
        </div>
      </dl>
    </section>
  </main>
  <footer class="report-footer">
    <p>Generated with PaperForge.</p>
  </footer>
</body>
</html>
