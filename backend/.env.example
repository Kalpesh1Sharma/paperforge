# Preferred provider. AI_PROVIDER_ORDER controls automatic failover.
AI_PROVIDER=gemini
AI_PROVIDER_ORDER=gemini,mistral,groq,openai_compatible,deterministic
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=1
AI_TIMEOUT_SECONDS=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter, Cerebras, NVIDIA, or another OpenAI-compatible service
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

SUPERDOCS_API_KEY=
SUPERDOCS_API_BASE_URL=https://api.superdocs.app
SUPERDOCS_POLL_INTERVAL_SECONDS=2
SUPERDOCS_MAX_WAIT_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REPORT_STORAGE_DIR=./reports
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
